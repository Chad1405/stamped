{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/keep-calendar/route.ts": {
      "experimentalTriggers": [{ "type": "schedule/v1beta" }]
    }
  },
  "schedules": {
    "keep-calendar": {
      "schedule": "0 6 * * *",
      "function": "api/keep-calendar"
    }
  }
}
